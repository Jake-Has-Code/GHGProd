# Copy this to .env. Secrets stay on the server; never prefix them NEXT_PUBLIC_.
APP_URL=http://localhost:3000
CHECKOUT_ENABLED=false
# Use Stripe test credentials together with Prodigi sandbox credentials first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRODIGI_API_KEY=
# Confirm the countries, pricing, and shipping cost you intend to offer.
SHIPPING_COUNTRIES=US
SHIPPING_CENTS=599
# Set automatically by Docker Compose. For local integration testing only:
# DOCKER_RUNTIME=true
# ORDER_STORE_DIR=/absolute/path/to/order-data
# Optional JSON override for config/variants.json:
# PRODIGI_VARIANTS_JSON=
