# Copy this to .env. Keep credentials on the server, without NEXT_PUBLIC_ prefixes.
APP_URL=http://localhost:3000
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create an API-connected store in Printify; use its personal access token and shop ID.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Stripe test payments are recorded locally; they never create Printify orders.
# Paid LIVE Stripe sessions create orders using the store's Printify approval settings.
SHIPPING_COUNTRIES=US
SHIPPING_CENTS=599
# Set automatically by Docker Compose. For local integration testing only:
# DOCKER_RUNTIME=true
# ORDER_STORE_DIR=/absolute/path/to/order-data
# Optional JSON override for config/variants.json:
# PRINTIFY_VARIANTS_JSON=
